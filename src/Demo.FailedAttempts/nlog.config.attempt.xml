<?xml version="1.0" encoding="utf-8" ?>
<!--
  FAILED ATTEMPT #1 — see README.md in this project.

  Filters by exception TYPE, but the original problem needs filtering by exception
  CAUSE ("was this HTTP request cancelled by the user"), which NLog config has no
  access to: it never sees HttpContext.RequestAborted, only the rendered log event.
  As a result this rule also swallows OperationCanceledException raised by DB command
  timeouts, HttpClient timeouts, or manually cancelled background work.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target xsi:type="File" name="mainFile" fileName="logs/app.log" />
  </targets>

  <rules>
    <logger name="*" minlevel="Error" writeTo="mainFile">
      <filters defaultAction="Log">
        <when condition="contains('${exception:format=Type}', 'OperationCanceledException')"
              action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
